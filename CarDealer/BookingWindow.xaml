<Window x:Class="CarDealer.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бронирование"
        Height="310"
        Width="320"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        ResizeMode="NoResize">

    <Grid>

        <!-- Карточка -->
        <Border Background="White"
                CornerRadius="10"
                Padding="20"
                Margin="15"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <StackPanel>

                <!-- Заголовок -->
                <TextBlock Text="Бронирование авто"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <!-- ФИО -->
                <TextBlock Text="ФИО" Foreground="Gray"/>
                <TextBox x:Name="NameBox"
                         Height="30"
                         Margin="0,5,0,10"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон" Foreground="Gray"/>
                <TextBox x:Name="PhoneBox"
                         Height="30"
                         Margin="0,5"
                         PreviewTextInput="PhoneBox_PreviewTextInput"
                         TextChanged="PhoneBox_TextChanged"/>

                <!-- Кнопка -->
                <Button Content="Забронировать"
                        Height="35"
                        Margin="0,15,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Confirm_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>