<Window x:Class="CarDealer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CarDealer"
        Title="Автосалон" Height="650" Width="1100"
        Background="#F5F6F8">

    <Window.Resources>
        <local:ByteArrayToImageConverter x:Key="ImageConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Background="#1F2937" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TimeText"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="14"
                       Margin="20"/>

            <TextBlock Text="АВТОСАЛОН PREMIUM"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"/>

            <Button Content="Войти"
                    Grid.Column="2"
                    Width="100"
                    Height="32"
                    HorizontalAlignment="Right"
                    Margin="20"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OpenLogin_Click"/>
        </Grid>

        <!-- Фильтры -->
        <Border Grid.Row="1" Background="White" Margin="15,15,15,10" CornerRadius="10" Padding="10">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <StackPanel Margin="10">
                    <TextBlock Text="Цена от" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="PriceFromBox" Width="90" Height="28" TextChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <TextBlock Text="Цена до" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="PriceToBox" Width="90" Height="28" TextChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <TextBlock Text="Год" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="YearBox" Width="90" Height="28" TextChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <TextBlock Text="Марка" FontSize="12" Foreground="Gray"/>
                    <ComboBox x:Name="BrandBox" Width="120" Height="28" SelectionChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <TextBlock Text="Цвет" FontSize="12" Foreground="Gray"/>
                    <ComboBox x:Name="ColorBox" Width="120" Height="28" SelectionChanged="FilterChanged"/>
                </StackPanel>

                <Button Content="Сбросить"
                        Width="100"
                        Height="32"
                        Margin="20,15,0,0"
                        Background="#EF4444"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ResetFilter_Click"/>

            </StackPanel>

        </Border>

        <!-- Витрина -->
        <ScrollViewer Grid.Row="2" Margin="10">
            <ItemsControl x:Name="CarsList">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Width="200"
                                Margin="10"
                                Background="White"
                                CornerRadius="10"
                                Padding="10"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <StackPanel>

                                <!-- Фото -->
                                <Grid Height="120">

                                    <Border Background="#E5E7EB" CornerRadius="6"/>

                                    <Image Stretch="UniformToFill"
                                           Source="{Binding Photo, Converter={StaticResource ImageConverter}}"/>

                                    <TextBlock Text="Фото нет"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="Gray"
                                               Visibility="{Binding Photo, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </Grid>

                                <!-- Характеристики -->
                                <TextBlock Text="{Binding Manufacturer}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="{Binding Model}" FontSize="13"/>

                                <TextBlock Text="{Binding Price}"
                                           Foreground="#16A34A"
                                           FontWeight="Bold"
                                           Margin="0,4,0,8"/>

                                <!-- Кнопка -->
                                <Button Content="Забронировать"
                                        Height="30"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="BookButton_Click"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Window>