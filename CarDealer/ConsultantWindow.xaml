<Window x:Class="CarDealer.ConsultantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Консультант"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Background="#1F2937">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="UserNameText"
                       VerticalAlignment="Center"
                       Margin="20"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>

            <Button Content="Выход"
                    Grid.Column="1"
                    Margin="15"
                    Background="#EF4444"
                    Foreground="White"
                    BorderThickness="0"
                    Height="35"
                    Click="Logout_Click"/>
        </Grid>

        <!-- Рабочая область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <ListBox x:Name="RequestsList"
                     SelectionChanged="RequestsList_SelectionChanged"
                     Margin="10"
                     Background="Transparent"
                     BorderThickness="0">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                Margin="6"
                                Padding="10"
                                CornerRadius="8"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="{Binding Cars.Manufacturer}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Cars.Model}"/>
                                <TextBlock Text="{Binding FullName}"/>
                                <TextBlock Text="{Binding Phone}" Foreground="Gray"/>
                            </StackPanel>

                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <!-- Центральная панель -->
            <Border Grid.Column="1"
                    Background="White"
                    Margin="10"
                    Padding="15"
                    CornerRadius="10"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Информация об авто"
                               FontWeight="Bold"
                               FontSize="15"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="CarInfo"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Что понравилось клиенту"
                               FontWeight="Bold"
                               Margin="0,10,0,5"/>

                    <CheckBox x:Name="CheckBrand" Content="Марка"/>
                    <CheckBox x:Name="CheckModel" Content="Модель"/>
                    <CheckBox x:Name="CheckColor" Content="Цвет"/>
                    <CheckBox x:Name="CheckBody" Content="Кузов"/>
                    <CheckBox x:Name="CheckPrice" Content="Цена"/>

                    <StackPanel Margin="0,15,0,0">

                        <Button Content="Клиент отказался"
                                Height="35"
                                Background="#EF4444"
                                Foreground="White"
                                BorderThickness="0"
                                Click="Reject_Click"/>

                        <Button Content="Клиент решил купить"
                                Height="35"
                                Margin="0,5"
                                Background="#16A34A"
                                Foreground="White"
                                BorderThickness="0"
                                Click="Buy_Click"/>

                        <Button Content="Показать похожие"
                                Height="35"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Click="FindSimilar_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- Правая панель -->
            <ListBox x:Name="SimilarCarsList"
                     Grid.Column="2"
                     SelectionChanged="SimilarCarsList_SelectionChanged"
                     Margin="10"
                     Background="Transparent"
                     BorderThickness="0">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Border Background="White"
                                Margin="6"
                                Padding="10"
                                CornerRadius="8"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="{Binding Manufacturer}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Model}"/>
                                <TextBlock Text="{Binding Price}"
                                           Foreground="#16A34A"
                                           FontWeight="Bold"/>
                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>
    </Grid>
</Window>