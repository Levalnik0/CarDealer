<Window x:Class="CarDealer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация"
        Height="455"
        Width="320"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        ResizeMode="NoResize">

    <Grid>

        <!-- Карточка -->
        <Border Background="White"
                CornerRadius="12"
                Padding="25"
                Margin="20"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <StackPanel>

                <!-- Назад -->
                <Button Content="← Назад"
                        Width="90"
                        Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#2563EB"
                        Click="Back_Click"/>

                <!-- Заголовок -->
                <TextBlock Text="Вход в систему"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,10,0,20"/>

                <!-- Логин -->
                <TextBlock Text="Логин" Foreground="Gray"/>
                <TextBox x:Name="LoginBox"
                         Height="32"
                         Margin="0,5,0,10"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль" Foreground="Gray"/>

                <Grid Margin="0,5">
                    <PasswordBox x:Name="PasswordBox" Height="32"/>
                    <TextBox x:Name="PasswordTextBox"
                             Height="32"
                             Visibility="Collapsed"/>
                </Grid>

                <!-- Показать пароль -->
                <CheckBox Content="Показать пароль"
                          Margin="0,10,0,0"
                          Checked="ShowPassword_Checked"
                          Unchecked="ShowPassword_Checked"/>

                <!-- Кнопка -->
                <Button Content="Войти"
                        Height="40"
                        Margin="0,20,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Login_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>